{
    "name": "roxomtv-teleprompter",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --keep-vars",
        "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "env:check": "node scripts/check-env.mjs",
        "db:migrate": "node scripts/apply-migrations.mjs",
        "smoke:playback": "node scripts/smoke-playback.mjs",
        "smoke:views": "node scripts/smoke-views.mjs",
        "check:rich-selection": "node scripts/check-rich-selection.mjs",
        "start": "next start",
        "lint": "eslint --max-warnings=0 src --ext .ts,.tsx",
        "typecheck": "next typegen && tsc --noEmit"
    },
    "dependencies": {
        "@opennextjs/cloudflare": "1.19.11",
        "@supabase/supabase-js": "2.48.1",
        "jszip": "^3.10.1",
        "lucide-react": "0.468.0",
        "next": "15.5.18",
        "pg": "8.13.1",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@types/node": "22.10.1",
        "@types/pg": "8.11.11",
        "@types/react": "19.0.1",
        "@types/react-dom": "19.0.2",
        "eslint": "8.57.1",
        "eslint-config-next": "15.5.18",
        "typescript": "5.7.2",
        "wrangler": "4.90.1"
    }
}
