[Unit]
Description=Teleprompter Next.js app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=diego
Group=diego
WorkingDirectory=/home/diego/Documents/teleprompter/teleprompter
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PORT=3458
EnvironmentFile=/home/diego/Documents/teleprompter/teleprompter/.env.local
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3458
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
